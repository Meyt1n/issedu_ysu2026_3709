{
  "name": "homecare-twin-mobile",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "家健镜 HomeCare Twin 随身照护移动端（教学演示，含无障碍长辈模式）",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "check": "vue-tsc --noEmit",
    "test": "vitest run",
    "android:sync": "npm run build && cap sync android",
    "verify:android-a11y-evidence": "node scripts/verify-android-a11y-evidence.mjs",
    "verify:android-voice-evidence": "node scripts/verify-android-voice-evidence.mjs",
    "verify:android-reminder-evidence": "node scripts/verify-android-reminder-evidence.mjs",
    "verify:android-risk-evidence": "node scripts/verify-android-risk-evidence.mjs",
    "verify:environment-action-evidence": "node scripts/verify-android-environment-evidence.mjs",
    "verify:onboarding-evidence": "node scripts/verify-android-onboarding-evidence.mjs",
    "verify:weak-network-evidence": "node scripts/verify-android-weak-network-evidence.mjs",
    "android:sync:debug": "vite build --mode android-debug && cap sync android",
    "audit:android-security": "node scripts/audit-android-security.mjs",
    "audit:responsive": "node scripts/audit-responsive-layout.mjs",
    "serve:controlled-https": "node scripts/controlled-https-fixture.mjs",
    "seed:live": "node scripts/seed-live-demo.mjs",
    "demo:ready": "node scripts/mobile-demo-ready.mjs",
    "verify:linkage": "node scripts/verify-web-linkage.mjs",
    "audit:pwa": "npm run build && node scripts/audit-pwa.mjs",
    "verify:controlled-release": "node scripts/verify-controlled-release.mjs",
    "test:controlled-release": "node scripts/verify-controlled-release.test.mjs",
    "privacy:scan": "node scripts/privacy-scan.mjs",
    "release:manifest": "node scripts/release-manifest.mjs",
    "test:privacy-scan": "node scripts/privacy-scan.test.mjs",
    "perf:budget": "npm run build && node scripts/perf-budget.mjs",
    "perf:budget:low-end": "npm run build && node scripts/perf-budget.mjs --cpu 4 --network Slow 3G --target low-end-sim",
    "test:perf-budget": "node scripts/perf-budget-lib.test.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.0",
    "@capacitor/core": "^8.5.0",
    "@capacitor/local-notifications": "^8.3.1",
    "vue": "3.5.13",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@capacitor/cli": "8.4.2",
    "@types/node": "22.15.30",
    "@vitejs/plugin-vue": "5.2.1",
    "happy-dom": "20.11.6",
    "typescript": "5.7.3",
    "vite": "6.4.3",
    "vitest": "^3.2.6",
    "vue-tsc": "^2.2.8"
  }
}
