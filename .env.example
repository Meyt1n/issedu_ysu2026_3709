APP_ENV=development
APP_NAME=HomeCare Twin API
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO

# HCT-498: Web and Compose use formal account/password sessions by default.
# Set true only for an explicitly isolated non-production API diagnostic; Web never exposes it.
ALLOW_DEV_ACTOR_HEADER=false
# HCT-453: member entry (5173 dev / 8080 compose) and admin entry (5174 dev / 8081 compose).
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:8080,http://localhost:8081

# Docker Compose defaults. Never commit real passwords.
MYSQL_DATABASE=homecare
MYSQL_USER=homecare
MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_PORT=3306
# HCT-453 双入口：WEB_PORT=成员前台，ADMIN_WEB_PORT=管理后台（同一容器两个监听端口）。
WEB_PORT=8080
ADMIN_WEB_PORT=8081
# Compose 档位：basic=API/Web/MySQL/outbox；enhanced=再加 Ollama 容器
COMPOSE_PROFILES=basic
DATABASE_URL=mysql+pymysql://homecare:change-me@localhost:3306/homecare?charset=utf8mb4

# Local file and request limits
# Relative FILE_ROOT is resolved against the repository root so restarting
# the API from another working directory still finds uploaded originals.
FILE_ROOT=./data/files
MASTER_DATA_ROOT=./data/master-data
# HCT-201 教学演示主数据（合成数据，INTERNAL_TEACHING_DEMO 批准范围，见
# docs/data/HCT-201-教学演示批准范围-V1.md）。开启教学演示路径：
#   1. uv run python scripts/setup_vision_demo.py   # 生成 data/master-data/demo-cn-en-v1.json
#   2. 取消下一行注释（Docker Compose 会把该变量透传给 api 容器）
# MASTER_DATA_APPROVED_VERSIONS=demo-cn-en-v1
# 注意：HCT-201 正式药品集仍为 UNRELEASED（fixed-set gate 未通过），
# 本变量只能指向已批准的教学/合成版本，不得登记未批准的真实药品集。
MASTER_DATA_APPROVED_VERSIONS=
MAX_UPLOAD_BYTES=10485760
REQUEST_ID_HEADER=X-Request-ID
CURSOR_SIGNING_KEY=dev-only-change-me
DEFAULT_HOUSEHOLD_TIME_ZONE=UTC
OUTBOX_POLL_SECONDS=2
OUTBOX_BATCH_SIZE=100
OUTBOX_STALE_SECONDS=300

# Capability versions are explicit even while adapters are unavailable.
VISION_MODEL_VERSION=unavailable
OCR_VERSION=unavailable
VISION_ADAPTER_SIGNING_KEY=dev-only-change-me
VISION_ADAPTER_ALLOWLIST=homecare-local-vision
VISION_QUALITY_CONFIG_VERSION=opencv-quality-demo-v2-lenient-exposure
VISION_QUALITY_ENFORCE_RETAKE=true
# HCT-439: temporary video evidence retention (24h) and per-pass safety cap.
VISION_VIDEO_RETENTION_SECONDS=86400
VISION_VIDEO_CLEANUP_BATCH_SIZE=100
# Video evidence intake: set VISION_VIDEO_TASKS_ENABLED=false to accept photos only.
VISION_VIDEO_TASKS_ENABLED=true
VISION_VIDEO_MAX_DURATION_SECONDS=30
# Vision worker leasing: how long one claim is held, how many attempts before a
# task is parked for manual retry, and how many tasks one poll may claim.
VISION_WORKER_LEASE_SECONDS=900
VISION_WORKER_MAX_ATTEMPTS=3
VISION_WORKER_CLAIM_BATCH_SIZE=10
VISION_QUALITY_MIN_WIDTH=640
VISION_QUALITY_MIN_HEIGHT=480
VISION_QUALITY_MIN_BLUR_VARIANCE=80
VISION_QUALITY_MIN_MEAN_LUMINANCE=45
VISION_QUALITY_MAX_MEAN_LUMINANCE=220
VISION_QUALITY_MAX_DARK_RATIO=0.45
VISION_QUALITY_MAX_BRIGHT_RATIO=0.60
VISION_QUALITY_MAX_GLARE_RATIO=0.35
VISION_QUALITY_MIN_EDGE_DENSITY=0.005
VISION_QUALITY_MIN_SUBJECT_AREA_RATIO=0.08
VISION_QUALITY_MAX_BORDER_TOUCH_RATIO=0.50
BIOMETRIC_ENCRYPTION_KEY=dev-only-biometric-key-change-me
# Local YuNet + SFace cache (weights are not in git). First use may download when auto-download is true.
FACE_MODEL_DIR=./models/face
FACE_MODEL_AUTO_DOWNLOAD=true
# Calibrate with a local camera sample tree (cloud agents cannot capture real faces):
#   uv run python scripts/calibrate_face_thresholds.py ./face-samples
# Then copy recommended values into this file and restart the API.
# See docs/本地部署与Demo操作指南.md §1.3.
FACE_MATCH_THRESHOLD_SFACE=0.40
FACE_MATCH_MARGIN_SFACE=0.05
# Face *enrolment* always requires the turn-head liveness check
# (FACE_REQUIRE_POSE_LIVENESS below).  Login keeps it off by default so elderly
# members are not locked out by a missed turn; set true to require it there too.
FACE_LOGIN_REQUIRE_POSE_LIVENESS=false
FACE_REQUIRE_POSE_LIVENESS=true
RULESET_VERSION=rules-v0
KNOWLEDGE_VERSION=knowledge-v0
EMBEDDING_VERSION=unavailable
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=unavailable
OLLAMA_TIMEOUT_SECONDS=30

# ── 模型后端开关（仅运维配置，前端无入口、能力清单不变）─────────────────
# local（默认）：全部推理留在本机，符合项目默认拒绝外发的姿态。
# cloud：把同样的调用改发到 OpenAI 兼容接口。提示词、工具契约、安全门与
#        响应结构完全不变，因此调用方和前端都无需改动。
#
# 这是一次显式的外发决定：对话内容可能包含成员健康事实，开启即代表这些
# 内容会发往第三方，所以默认关闭，且不做任何界面开关。
# 半配置（填了 cloud 但缺 key、或写成 http://）会自动回落本地，不会让每次
# 请求都失败。
LLM_PROVIDER=local

# DeepSeek 示例（OpenAI 兼容）。换其他服务商时只改这四项。
#   末尾带不带 /v1 都可以，适配器会自行补全 /chat/completions。
LLM_API_BASE_URL=https://api.deepseek.com/v1
# 真实密钥只写进本机 .env（已被 .gitignore 忽略），不要提交到仓库。
LLM_API_KEY=
# deepseek-chat = V3 通用对话（推荐，支持工具调用）
# deepseek-reasoner = R1 思考模型；工具与 JSON 契约支持较弱，如需使用
#   建议同时把 LLM_API_SUPPORTS_TOOLS 与 RESPONSE_FORMAT_MODE 调低一档。
LLM_API_MODEL=deepseek-chat
# 云端首字延迟高于本机，超时给得比 OLLAMA_TIMEOUT_SECONDS 宽。
LLM_API_TIMEOUT_SECONDS=60
LLM_API_MAX_TOKENS=2048
LLM_API_SUPPORTS_TOOLS=true
# json_schema：OpenAI 式严格 Schema
# json_object：只保证是合法 JSON —— DeepSeek 的 chat/completions 只认这个，
#              发 json_schema 会让每次合成调用直接 400
# none：不发该字段，仅靠提示词 + 应用层校验（本地模型本来就是这样）
LLM_API_RESPONSE_FORMAT_MODE=json_object
# 仅当网关会重定向到同族域名时才需要补充，逗号分隔。
LLM_API_EXTRA_ALLOWED_HOSTS=

CARE_PLAN_POLL_SECONDS=30
# HCT-430: agent orchestration and Ollama stay local. Network search is
# disabled by default and requires explicit per-request opt-in as well.
# To enable: set AGENT_WEB_SEARCH_ENABLED=true, restart the API, then tick
# 「补充联网参考」 in the assistant page per request (dual opt-in).
# Providers: duckduckgo_html (default, HTTPS + domain allowlist required),
# searxng (self-hosted JSON API), fixture (offline teaching fixtures — no
# egress at all; ideal for classroom demos without network access).
AGENT_ORCHESTRATION_ENABLED=true
AGENT_WEB_SEARCH_ENABLED=false
AGENT_WEB_SEARCH_PROVIDER=duckduckgo_html
AGENT_WEB_SEARCH_URL=https://html.duckduckgo.com/html/
AGENT_WEB_SEARCH_TIMEOUT_SECONDS=8
AGENT_WEB_SEARCH_MAX_RESULTS=5
AGENT_WEB_SEARCH_ALLOWED_DOMAINS=html.duckduckgo.com
AGENT_WEB_SEARCH_CACHE_TTL_SECONDS=180
AGENT_WEB_SEARCH_MIN_INTERVAL_SECONDS=1
# ADR-0007 (3B): egress mode. allowlist (default) requires the domain
# allowlist above; open allows public HTTPS hosts only (SSRF-guarded) and
# fetches short excerpts from top result pages. Rollback: set back to allowlist.
AGENT_WEB_SEARCH_EGRESS_MODE=allowlist
AGENT_WEB_SEARCH_EMPTY_CACHE_TTL_SECONDS=30
AGENT_WEB_SEARCH_FETCH_PAGE_COUNT=2
AGENT_WEB_SEARCH_FETCH_PAGE_MAX_BYTES=204800
AGENT_WEB_SEARCH_FETCH_PAGE_TIMEOUT_SECONDS=6
# HCT-442: optional loopback Ollama question classifier (merged with lexicon).
AGENT_CLASSIFIER_ENABLED=false
AGENT_CLASSIFIER_TIMEOUT_SECONDS=3
# Set to 0 to disable the actor/session-scoped local retrieval cache.
AGENT_RETRIEVAL_CACHE_TTL_SECONDS=120
# HCT-451: open-chat demo (DEFAULT ON for local demos). See docs/助手开放演示模式.md
# Since ADR-0007 (8C) open chat is an experience-only knob (local time
# injection, higher token floor); it no longer bypasses any safety check and
# is allowed in production.
AGENT_OPEN_CHAT=true
AGENT_OPEN_MAX_TOKENS=4096
WEATHER_ADAPTER=disabled
# Supported values: generic (canonical response) or uapis (adcode JSON demo provider).
WEATHER_PROVIDER=generic
WEATHER_API_URL=
WEATHER_API_TIMEOUT_SECONDS=3.0
# 仅允许 6 位城市/区县行政区划代码；启用时白名单必须同时包含默认值。
WEATHER_DEFAULT_CITY_CODE=
WEATHER_DEFAULT_DISTRICT_CODE=
WEATHER_LOCATION_WHITELIST=
WEATHER_CACHE_TTL_SECONDS=600
WEATHER_STALE_TTL_SECONDS=21600
WEATHER_MIN_REQUEST_INTERVAL_SECONDS=1.0
WEATHER_RETRY_ATTEMPTS=2
WEATHER_RETRY_BACKOFF_SECONDS=0.1
WEATHER_RULESET_VERSION=weather-actions-v1
EGRESS_DEFAULT_DENY=true
EGRESS_WEATHER_WHITELIST=
# HCT-445 home health news: local = seasonal only (default, no egress).
# enabled requires HEALTH_NEWS_ALLOWED_DOMAINS (e.g. www.who.int,www.nhc.gov.cn,www.chinacdc.cn).
HEALTH_NEWS_ADAPTER=local
HEALTH_NEWS_ALLOWED_DOMAINS=
# Optional: who_news_en,nhc_xwzx,chinacdc_zxxx — empty means all built-ins whose host is allowlisted.
HEALTH_NEWS_SOURCE_IDS=
# Extra sources: id|name|https_url|rss_or_html_list|optional_path_hint ; separated by ;
HEALTH_NEWS_EXTRA_SOURCES=
HEALTH_NEWS_TIMEOUT_SECONDS=8.0
HEALTH_NEWS_CACHE_TTL_SECONDS=1800
HEALTH_NEWS_STALE_TTL_SECONDS=86400
HEALTH_NEWS_MIN_REQUEST_INTERVAL_SECONDS=2.0
HEALTH_NEWS_RETRY_ATTEMPTS=2
HEALTH_NEWS_RETRY_BACKOFF_SECONDS=0.15
HEALTH_NEWS_MAX_ITEMS=6
LOG_MASK_ENABLED=true
UPLOAD_ALLOWED_EXTENSIONS=.jpg,.jpeg,.png,.pdf,.mp4,.mov
UPLOAD_MAX_SIZE_BYTES=10485760
# Optional comma-separated actor ids. Empty = creator-only for internal knowledge /
# only binding creator may activate/rollback model releases.
KNOWLEDGE_ADMIN_ACTORS=
MODEL_RELEASE_ADMIN_ACTORS=
# Require activator != binding creator (HCT-404 dual-control). Set false for
# single-operator local drills.
MODEL_RELEASE_DUAL_CONTROL=true
# When true, household owners must send X-Access-Purpose for field reads.
OWNER_REQUIRES_ACCESS_PURPOSE=false
# Vision worker Bearer token when ALLOW_DEV_ACTOR_HEADER=false (optional).
# HCT_WORKER_TOKEN=
