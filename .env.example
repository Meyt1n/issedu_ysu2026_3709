APP_ENV=development
APP_NAME=HomeCare Twin API
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO

# Local development identity scaffold. Replace with real authentication before production.
ALLOW_DEV_ACTOR_HEADER=true
CORS_ORIGINS=http://localhost:5173,http://localhost:8080

# Docker Compose defaults. Never commit real passwords.
MYSQL_DATABASE=homecare
MYSQL_USER=homecare
MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_PORT=3306
WEB_PORT=8080
DATABASE_URL=mysql+pymysql://homecare:change-me@localhost:3306/homecare?charset=utf8mb4

# Local file and request limits
FILE_ROOT=./data/files
MAX_UPLOAD_BYTES=10485760
REQUEST_ID_HEADER=X-Request-ID
OUTBOX_POLL_SECONDS=2
OUTBOX_BATCH_SIZE=100
OUTBOX_STALE_SECONDS=300

# Capability versions are explicit even while adapters are unavailable.
VISION_MODEL_VERSION=unavailable
OCR_VERSION=unavailable
VISION_QUALITY_CONFIG_VERSION=opencv-quality-demo-v1
VISION_QUALITY_MIN_WIDTH=640
VISION_QUALITY_MIN_HEIGHT=480
VISION_QUALITY_MIN_BLUR_VARIANCE=80
VISION_QUALITY_MIN_MEAN_LUMINANCE=45
VISION_QUALITY_MAX_MEAN_LUMINANCE=220
VISION_QUALITY_MAX_DARK_RATIO=0.45
VISION_QUALITY_MAX_BRIGHT_RATIO=0.35
VISION_QUALITY_MAX_GLARE_RATIO=0.15
VISION_QUALITY_MIN_EDGE_DENSITY=0.005
VISION_QUALITY_MIN_SUBJECT_AREA_RATIO=0.08
VISION_QUALITY_MAX_BORDER_TOUCH_RATIO=0.50
RULESET_VERSION=rules-v0
KNOWLEDGE_VERSION=knowledge-v0
EMBEDDING_VERSION=unavailable
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=unavailable
OLLAMA_TIMEOUT_SECONDS=30
WEATHER_ADAPTER=disabled
WEATHER_API_URL=
WEATHER_API_TIMEOUT_SECONDS=3.0
EGRESS_DEFAULT_DENY=true
EGRESS_WEATHER_WHITELIST=
LOG_MASK_ENABLED=true
UPLOAD_ALLOWED_EXTENSIONS=.jpg,.jpeg,.png,.pdf,.mp4,.mov
UPLOAD_MAX_SIZE_BYTES=10485760
