# Clean runtime layout: these assets stay on the demo machine and are never
# committed because they may contain health data or model weights.
src/runtime/data/
src/runtime/database/*.sqlite3
src/runtime/logs/
src/models/face/*.onnx
src/models/llm/**/*.gguf
src/models/vision/yolo/**/*.pt
src/models/vision/ocr/paddleocr/ppocrv4-ch/**
